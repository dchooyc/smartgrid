# Settings for hosting the app with compose.prod.yaml. On the server, copy
# this file to .env and fill it in:
#
#   cp .env.example .env
#
# .env is not in the repository, so the real values stay on the server.

# The address the site is served at, without "https://".
SITE_ADDRESS=smartgrid.example.com

# The username and password the site asks for.
DEMO_USER=reviewer

# The password, hashed. Make the hash with:
#
#   docker run --rm -it caddy:2 caddy hash-password
#
# Keep the single quotes around it, so its "$" signs are left alone.
DEMO_PASSWORD_HASH='$2a$14$replace-this-with-the-hash'
